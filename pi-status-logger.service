[Unit]
Description=Raspberry Pi Status Logger
After=network.target

[Service]
Type=simple
ExecStart=/home/idks/develop/bash/camrec/pi-status-logger.sh
User=idks
Group=pilogs
Restart=always
RestartSec=5

# Redirect stdout and stderr to journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
