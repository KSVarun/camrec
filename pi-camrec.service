[Unit]
Description=Raspberry Pi Camera Record Logger
After=network.target

[Service]
Type=simple
ExecStart=/home/idks/develop/bash/pi-camera-record.sh
User=idks
Group=pilogs
Restart=always
RestartSec=5

# Redirect stdout and stderr to journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
